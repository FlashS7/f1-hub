# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → secret / service_role key. Server only, never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel sends it to /api/cron/score.
CRON_SECRET=
